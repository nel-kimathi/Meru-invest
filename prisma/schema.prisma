// MIICTF Digital Platform — Prisma schema (MySQL)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DELEGATE
  SPONSOR
  EXHIBITOR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationCategory {
  DELEGATE
  SPONSOR
  EXHIBITOR
}

model User {
  id                 String             @id
  name               String
  email              String             @unique
  emailVerified      Boolean            @default(false)
  image              String?
  phone              String?
  organization       String?
  country            String?
  category           RegistrationCategory @default(DELEGATE)
  role               Role               @default(DELEGATE)
  registrationStatus RegistrationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           Session[]
  accounts           Account[]
  booths             Booth[]
  systemLogs         SystemLog[]
  sponsorProfile     SponsorProfile?
  exhibitorProfile   ExhibitorProfile?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- CMS (public site content) ---

model Page {
  id       String    @id
  slug     String    @unique // e.g. "home", "about", "trade-fair"
  title    String
  sections Section[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("page")
}

model Section {
  id        String   @id
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String   // e.g. "hero", "leadership", "body", "cta"
  order     Int      @default(0)
  title     String?
  subtitle  String?
  body      String?  @db.Text // markdown / rich text
  imageUrl  String?
  metadata  Json?    // structured content: cards, tiers, events, faq items
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("section")
}

// --- Newsletter (footer signup on the public site) ---

model NewsletterSubscriber {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscriber")
}

// --- News (public list/detail; admin CRUD arrives in Phase 2) ---

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum BoothStatus {
  AVAILABLE
  RESERVED
  ALLOCATED
  OCCUPIED
}

model News {
  id          String     @id
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String     @db.Text
  coverImage  String?
  category    String?    // free-text for now; category management is Phase 2
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("news")
}

// --- Booth management (halls + booths; supports future visual booth map) ---

model ExhibitionHall {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booths      Booth[]

  @@map("exhibition_hall")
}

model Booth {
  id          String      @id @default(cuid())
  hallId      String
  number      String
  size        String?
  category    String?
  status      BoothStatus @default(AVAILABLE)
  price       Decimal?    @db.Decimal(10, 2)
  exhibitorId String?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  hall               ExhibitionHall   @relation(fields: [hallId], references: [id], onDelete: Cascade)
  exhibitor          User?            @relation(fields: [exhibitorId], references: [id], onDelete: SetNull)
  exhibitorProfiles  ExhibitorProfile[]

  @@unique([hallId, number])
  @@map("booth")
}

// --- Site settings (editable configuration) ---

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

// --- System logs (audit trail of admin actions) ---

model SystemLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g. CREATE, UPDATE, DELETE, APPROVE, ASSIGN
  entityType  String   // e.g. USER, DELEGATE, SPONSOR, EXHIBITOR, BOOTH, HALL, NEWS
  entityId    String?
  details     Json?    // structured payload
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("system_log")
}

// --- Sponsor profile (full sponsor-facing details) ---

model SponsorProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  category       String?            // e.g. Star, Platinum, Gold, Silver, Bronze
  companyInfo    String?            @db.Text
  brandAssets    Json?              // array of { name, url }
  status         RegistrationStatus @default(PENDING)
  contactPersons Json?              // array of { name, email, phone, role }
  websiteLink    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sponsor_profile")
}

// --- Exhibitor profile (full exhibitor-facing details + booth allocation) ---

model ExhibitorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyProfile     String?            @db.Text
  industry           String?
  products           Json?              // array of { name, description }
  contactInfo        Json?              // { phone, email, address }
  registrationStatus RegistrationStatus @default(PENDING)
  boothId            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  booth Booth? @relation(fields: [boothId], references: [id], onDelete: SetNull)

  @@map("exhibitor_profile")
}