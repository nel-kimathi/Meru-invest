# Database — MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/miictf"

# Better Auth
# Random base64 string — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-64-char-secret"
# Public origin of the app in production
BETTER_AUTH_URL="http://localhost:3000"

# Email (Hostinger SMTP in production). Verification emails are stubbed in dev.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="replace-me"
SMTP_FROM="MIICTF <noreply@example.com>"

# Optional: global site access password.
# When set, all public pages require this password before rendering.
# Leave blank in development to keep the site open.
SITE_ACCESS_PASSWORD=""
